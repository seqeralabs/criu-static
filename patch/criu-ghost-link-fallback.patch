+/*
+ * Errors with which linkat() reports that the filesystem cannot create hard
+ * links at all, e.g. a FUSE server without LINK support re-exported over NFS,
+ * which returns ENOTSUPP (524, kernel-internal and unknown to libc).
+ */
+static inline bool link_unsupported(int err)
+{
+	return err == EOPNOTSUPP || err == EPERM || err == 524 /* ENOTSUPP */;
+}
